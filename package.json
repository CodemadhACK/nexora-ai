{
  "name": "nexora-ai",
  "productName": "Nexora AI",
  "version": "3.0.0",
  "description": "Nexora AI — an always-on-top assistant for technical interviews and meetings. It captures your screen, your microphone and system audio, then answers with what to say out loud, the reasoning, working code and the complexity. Claude, Gemini or OpenAI, with your own key and no server in between.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test",
    "icons": "node tools/make-icons.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.nexora.ai",
    "productName": "Nexora AI",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "capture-privacy-test.html",
      "capture-privacy-demo.js",
      "screen-capture-privacy.js",
      "resume-pdf.js",
      "audio-dsp.js",
      "audio-worklet.js",
      "voice-turn.js",
      "safe-mode.js",
      "presentation-mode.js",
      "presentation-watch.js",
      "tray-menu.js",
      "tray-icon.js",
      "hotkeys.js",
      "credentials.js",
      "displays.js",
      "agents.js",
      "prompts.js",
      "settings-schema.js",
      "providers/**/*",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nexora AI"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.icns",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nexora uses your microphone for push-to-talk questions.",
        "NSScreenCaptureUsageDescription": "Nexora captures a screenshot of the display you choose when you ask a question about your screen."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
