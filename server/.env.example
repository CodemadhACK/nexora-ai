# ─── required ───────────────────────────────────────────────────────────────
# 32 bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this makes every stored provider API key undecryptable.
APP_ENCRYPTION_KEY=

NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/nexora.db

# Where the browser app lives. Used for CORS, OAuth redirects and email links.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1

# ─── first admin (seed only) ────────────────────────────────────────────────
ADMIN_EMAIL=admin@nexora.local
# Leave blank to have one generated and printed once.
ADMIN_PASSWORD=

# ─── Google sign-in (optional) ──────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Cashfree (optional; can also be set in the admin console) ──────────────
# sandbox | production. Never mix credentials between the two.
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
